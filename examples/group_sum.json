{
  "requirement": "Group rows by their `type` field and sum `amount` within each group, returning {type: total}. The amount may carry a currency symbol and thousands separators and must be cleaned; an empty string or anything with no digits counts as 0.",
  "examples": [
    {
      "input": {
        "rows": [
          {
            "type": "refund",
            "amount": "$1,200.50"
          },
          {
            "type": "sale",
            "amount": "$300"
          }
        ]
      },
      "output": {
        "refund": 1200.5,
        "sale": 300.0
      }
    },
    {
      "input": {
        "rows": []
      },
      "output": {},
      "boundary": true,
      "note": "empty input"
    },
    {
      "input": {
        "rows": [
          {
            "type": "sale",
            "amount": ""
          }
        ]
      },
      "output": {
        "sale": 0.0
      },
      "boundary": true,
      "note": "an empty amount counts as 0"
    },
    {
      "input": {
        "rows": [
          {
            "type": "sale",
            "amount": "$100"
          },
          {
            "type": "sale",
            "amount": "$50"
          }
        ]
      },
      "output": {
        "sale": 150.0
      }
    },
    {
      "input": {
        "rows": [
          {
            "type": "fee",
            "amount": "-$25.50"
          }
        ]
      },
      "output": {
        "fee": -25.5
      },
      "boundary": true,
      "note": "negative"
    }
  ]
}
