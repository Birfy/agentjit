{
  "requirement": "把 {name, score} 记录按 score 从高到低排名次。同分并列同一名次，之后的名次跳号（1,1,3 而不是 1,1,2）。同分之间按 name 字典序排列。返回 [{name, rank}]，按名次升序。",
  "examples": [
    {
      "input": {
        "records": [
          {
            "name": "alice",
            "score": 90
          },
          {
            "name": "bob",
            "score": 85
          },
          {
            "name": "carol",
            "score": 90
          }
        ]
      },
      "output": [
        {
          "name": "alice",
          "rank": 1
        },
        {
          "name": "carol",
          "rank": 1
        },
        {
          "name": "bob",
          "rank": 3
        }
      ],
      "note": "并列后跳号"
    },
    {
      "input": {
        "records": []
      },
      "output": [],
      "boundary": true
    },
    {
      "input": {
        "records": [
          {
            "name": "solo",
            "score": 50
          }
        ]
      },
      "output": [
        {
          "name": "solo",
          "rank": 1
        }
      ],
      "boundary": true
    },
    {
      "input": {
        "records": [
          {
            "name": "p",
            "score": 10
          },
          {
            "name": "q",
            "score": 10
          },
          {
            "name": "r",
            "score": 10
          }
        ]
      },
      "output": [
        {
          "name": "p",
          "rank": 1
        },
        {
          "name": "q",
          "rank": 1
        },
        {
          "name": "r",
          "rank": 1
        }
      ],
      "boundary": true,
      "note": "全部并列"
    },
    {
      "input": {
        "records": [
          {
            "name": "m",
            "score": 5
          },
          {
            "name": "n",
            "score": 9
          },
          {
            "name": "o",
            "score": 7
          }
        ]
      },
      "output": [
        {
          "name": "n",
          "rank": 1
        },
        {
          "name": "o",
          "rank": 2
        },
        {
          "name": "m",
          "rank": 3
        }
      ]
    }
  ]
}
