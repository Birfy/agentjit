{
  "requirement": "Rank {name, score} records from highest score to lowest. Records with the same score share a rank, and the next rank skips accordingly (1, 1, 3 — not 1, 1, 2). Within a tie, order by name ascending. Return [{name, rank}] sorted by rank.",
  "examples": [
    {
      "input": {
        "records": [
          {
            "name": "alice",
            "score": 90
          },
          {
            "name": "bob",
            "score": 85
          },
          {
            "name": "carol",
            "score": 90
          }
        ]
      },
      "output": [
        {
          "name": "alice",
          "rank": 1
        },
        {
          "name": "carol",
          "rank": 1
        },
        {
          "name": "bob",
          "rank": 3
        }
      ],
      "note": "tie then skip"
    },
    {
      "input": {
        "records": []
      },
      "output": [],
      "boundary": true
    },
    {
      "input": {
        "records": [
          {
            "name": "solo",
            "score": 50
          }
        ]
      },
      "output": [
        {
          "name": "solo",
          "rank": 1
        }
      ],
      "boundary": true
    },
    {
      "input": {
        "records": [
          {
            "name": "p",
            "score": 10
          },
          {
            "name": "q",
            "score": 10
          },
          {
            "name": "r",
            "score": 10
          }
        ]
      },
      "output": [
        {
          "name": "p",
          "rank": 1
        },
        {
          "name": "q",
          "rank": 1
        },
        {
          "name": "r",
          "rank": 1
        }
      ],
      "boundary": true,
      "note": "everyone tied"
    },
    {
      "input": {
        "records": [
          {
            "name": "m",
            "score": 5
          },
          {
            "name": "n",
            "score": 9
          },
          {
            "name": "o",
            "score": 7
          }
        ]
      },
      "output": [
        {
          "name": "n",
          "rank": 1
        },
        {
          "name": "o",
          "rank": 2
        },
        {
          "name": "m",
          "rank": 3
        }
      ]
    }
  ]
}
