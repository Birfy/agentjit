{
  "name": "11_memory_bomb",
  "why": "sandbox gate: preallocation off by orders of magnitude — RLIMIT_AS on Linux, watchdog on macOS",
  "impl": "impl.py",
  "spec": {
    "intent": "group rows by type and sum amount; amount may carry a currency symbol and thousands separators, blank counts as 0",
    "param_schema": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "amount": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "amount"
            ]
          }
        }
      },
      "required": [
        "rows"
      ]
    },
    "return_schema": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "mem_mb": 256
  },
  "examples": [
    {
      "input": {
        "rows": [
          {
            "type": "refund",
            "amount": "$1,200.50"
          },
          {
            "type": "sale",
            "amount": "$300"
          }
        ]
      },
      "output": {
        "refund": 1200.5,
        "sale": 300.0
      }
    },
    {
      "input": {
        "rows": []
      },
      "output": {},
      "boundary": true,
      "note": "empty input"
    },
    {
      "input": {
        "rows": [
          {
            "type": "sale",
            "amount": ""
          }
        ]
      },
      "output": {
        "sale": 0.0
      },
      "boundary": true,
      "note": "blank amount counts as 0"
    },
    {
      "input": {
        "rows": [
          {
            "type": "sale",
            "amount": "$100"
          },
          {
            "type": "sale",
            "amount": "$50"
          }
        ]
      },
      "output": {
        "sale": 150.0
      }
    },
    {
      "input": {
        "rows": [
          {
            "type": "fee",
            "amount": "-$25.50"
          }
        ]
      },
      "output": {
        "fee": -25.5
      },
      "boundary": true,
      "note": "negative"
    }
  ],
  "expect": {
    "level": "REJECTED",
    "failing_gates": [
      "examples"
    ]
  }
}
