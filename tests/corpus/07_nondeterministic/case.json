{
  "name": "07_nondeterministic",
  "why": "确定性关卡：返回集合序，同样输入两次结果不同",
  "impl": "impl.py",
  "spec": {
    "intent": "列出出现过的 type，并统计行数",
    "param_schema": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      },
      "required": [
        "rows"
      ]
    },
    "return_schema": {
      "type": "object",
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "n": {
          "type": "integer"
        }
      },
      "required": [
        "types",
        "n"
      ]
    }
  },
  "examples": [
    {
      "input": {
        "rows": [
          {
            "type": "a"
          }
        ]
      },
      "output": {
        "types": [
          "a"
        ],
        "n": 1
      }
    },
    {
      "input": {
        "rows": []
      },
      "output": {
        "types": [],
        "n": 0
      },
      "boundary": true
    }
  ],
  "expect": {
    "level": "REJECTED",
    "failing_gates": [
      "determinism"
    ]
  }
}
