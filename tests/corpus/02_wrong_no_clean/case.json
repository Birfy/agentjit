{
  "name": "02_wrong_no_clean",
  "why": "例子关卡：没做清洗，第一个例子就对不上",
  "impl": "impl.py",
  "spec": {
    "intent": "把行按 type 分组对 amount 求和；amount 可能带货币符号和千分位逗号，空值按 0 算",
    "param_schema": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "amount": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "amount"
            ]
          }
        }
      },
      "required": [
        "rows"
      ]
    },
    "return_schema": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "examples": [
    {
      "input": {
        "rows": [
          {
            "type": "refund",
            "amount": "$1,200.50"
          },
          {
            "type": "sale",
            "amount": "$300"
          }
        ]
      },
      "output": {
        "refund": 1200.5,
        "sale": 300.0
      }
    },
    {
      "input": {
        "rows": []
      },
      "output": {},
      "boundary": true,
      "note": "空输入"
    },
    {
      "input": {
        "rows": [
          {
            "type": "sale",
            "amount": ""
          }
        ]
      },
      "output": {
        "sale": 0.0
      },
      "boundary": true,
      "note": "空金额按 0 算"
    },
    {
      "input": {
        "rows": [
          {
            "type": "sale",
            "amount": "$100"
          },
          {
            "type": "sale",
            "amount": "$50"
          }
        ]
      },
      "output": {
        "sale": 150.0
      }
    },
    {
      "input": {
        "rows": [
          {
            "type": "fee",
            "amount": "-$25.50"
          }
        ]
      },
      "output": {
        "fee": -25.5
      },
      "boundary": true,
      "note": "负数"
    }
  ],
  "expect": {
    "level": "REJECTED",
    "failing_gates": [
      "examples"
    ]
  }
}
